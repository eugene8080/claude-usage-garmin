<?xml version="1.0" encoding="UTF-8"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <!--
      A watch-app rather than a widget: watch-apps get a glance on fenix 8 class hardware
      (appTypes includes "glance"), which is the whole point here - the numbers should be
      readable from the glance carousel without launching anything.

      minApiLevel is 4.2.0: that is the floor for the Complications resource attributes used
      below (publishing the three meters as watchface complications). GlanceView needs only
      3.3, but every target is a fenix 8 class device on CIQ 6.x, so 4.2 costs no real
      coverage. The app itself never talks to claude.ai: Cloudflare's cf_clearance can only
      be minted in a real browser engine, and a Claude sessionKey has no business living in
      unencrypted watch storage. The phone authenticates and pushes three numbers over BLE;
      this app only renders whatever it was last told.
    -->
    <iq:application
        entry="ClaudeUsageApp"
        id="8a5bd20e02f34f58afb5f357a23a4a65"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="4.2.0"
        name="@Strings.AppName"
        type="watch-app">

        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fenix8pro47mm"/>
        </iq:products>

        <iq:permissions>
            <!-- Only to receive messages from the companion app. No web requests are made. -->
            <iq:uses-permission id="Communications"/>
            <!-- Publish the three meters as watchface complications. -->
            <iq:uses-permission id="ComplicationPublisher"/>
            <!-- A device app can only publish complications from a background service (a
                 foreground updateComplication faults), so the publish runs on a ~5-min
                 temporal event. -->
            <iq:uses-permission id="Background"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
