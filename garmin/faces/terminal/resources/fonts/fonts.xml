<fonts>
    <!-- IBM Plex Mono, generated from the TTF into CIQ bitmap fonts by tools/build_fonts_terminal.py.
         Sizes are the layout editor's: STMono = prompt (26px), STMonoSmall = date + meter rows
         (25px), both full printable ASCII; STMonoTime = the time (70px), digits + colon only;
         STMonoTimeOutline = the same time as 2 px hollow outlines, for always-on (low power).
         antialias="true" is REQUIRED - without it CIQ thresholds the atlas alpha to 1-bit and the
         text renders jagged; with it the smooth glyph edges are preserved on-device. -->
    <font id="STMono"      antialias="true" filename="stm_text.fnt" />
    <font id="STMonoSmall" antialias="true" filename="stm_small.fnt" />
    <font id="STMonoTime"  antialias="true" filename="stm_time.fnt" />
    <font id="STMonoTimeOutline" antialias="true" filename="stm_time_o.fnt" />
    <!-- Weather icons (Tabler, 24 px): copied from Claude Grid's cg_icon by the same script. -->
    <font id="STIcon" antialias="true" filename="stm_icon.fnt" />
    <!-- Soft halo twins of the prompt, date/row and icon fonts (tools/build_fonts_terminal.py,
         glow_from_bmfont): drawn under the sharp text in the Retro tube theme so everything
         glows like a phosphor tube. Same line metrics and advances as their sources. -->
    <font id="STMonoGlow"      antialias="true" filename="stm_text_glow.fnt" />
    <font id="STMonoSmallGlow" antialias="true" filename="stm_small_glow.fnt" />
    <font id="STIconGlow"      antialias="true" filename="stm_icon_glow.fnt" />
</fonts>
