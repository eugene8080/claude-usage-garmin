<properties>
    <!-- Toggled from the watch face settings; read in ClaudeFaceView.readSettings(). -->
    <property id="ShowSeconds" type="boolean">true</property>
    <!-- The prompt line's text. Default = the layout editor's Prompt text; editable in Garmin
         Connect (settings.xml) without rebuilding the face. -->
    <property id="PromptText" type="string">fenix@tactix ~ $</property>
    <!-- Colour theme: 0 = Night Owl, 1 = Retro tube (green phosphor, the default). Each has its own glow
         time digits (tools/build_glow_time.py THEMES). -->
    <property id="Theme" type="number">1</property>
    <!-- Old-monitor scanlines: thin horizontal lines over the face instead of the VFD mesh. -->
    <property id="Scanlines" type="boolean">true</property>
</properties>
