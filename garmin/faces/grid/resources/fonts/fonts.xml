<fonts>
    <!-- Roboto Mono (Regular/400), generated from the variable TTF into CIQ bitmap fonts by
         tools/build_fonts_grid.py. Each carries only the glyphs its fields draw, so the big
         sizes stay small: CGTime/CGTimeOutline are digits only. Sizes come straight from the
         layout editor's final numbers.
         antialias="true" is REQUIRED - without it CIQ thresholds the atlas alpha to 1-bit and the
         text renders jagged; with it the smooth glyph edges are preserved on-device. -->
    <font id="CGTime"        antialias="true" filename="cg_time.fnt" />
    <font id="CGTimeOutline" antialias="true" filename="cg_time_o.fnt" />
    <font id="CGBig"         antialias="true" filename="cg_big.fnt" />
    <font id="CGMed"         antialias="true" filename="cg_med.fnt" />
    <font id="CGWeek"        antialias="true" filename="cg_week.fnt" />
    <font id="CGSmall"       antialias="true" filename="cg_small.fnt" />
    <font id="CGTiny"        antialias="true" filename="cg_tiny.fnt" />
    <!-- Per-field icons from Tabler Icons (MIT), one glyph per complication type. -->
    <font id="TablerIcon"    antialias="true" filename="cg_icon.fnt" />
    <!-- Seconds-dial ticks: 60 pre-rasterised square-ended ticks on one shared cell, tinted per
         tick by setColor. Generated by tools/build_tick_font.py (see GridDraw.tickRing). -->
    <font id="CGTicks"       antialias="true" filename="cg_ticks.fnt" />
    <!-- Battery-arc dashes, pre-rasterised for the 454 px screen by tools/build_arc_font.py (used
         only on 454 px screens; see GridDraw.segmentArc). -->
    <font id="CGArc"         antialias="true" filename="cg_arc.fnt" />
</fonts>
