<?xml version="1.0" encoding="utf-8"?>
<!-- The usage grid is one fixed size: 2 x 1 cells, not resizable (Eugene, 2026-10-19).
     minWidth/minHeight are the pre-Android-12 cell formula (70 x n - 30 dp) for 2 x 1; Android 12+
     launchers place it by targetCellWidth/Height. The content scales to the cell's real size. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description_grid"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@drawable/usage_grid_preview" />
