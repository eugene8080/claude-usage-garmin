// Eugene's design, second round (emailed 2026-10-19 "claude widget settings"); built into widget/GridDesign.kt.
// Paste this whole block into the editor's settings box and press "Apply pasted" to edit it.
{
 "theme": "custom",
 "font": "monospace",
 "wLabel": 400,
