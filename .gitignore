*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
app/build/

# Release signing (never commit these)
/.signing/
*.keystore
*.jks

# Connect IQ build output - every project under garmin/ (watch app and faces)
garmin/**/build/
garmin/**/dist/

# Pre-2026-09-27 locations of the same folders. A checkout from before the move to garmin/ keeps
# its (ignored, so untracked) build/ and dist/ at these paths after pulling; these lines stop
# them surfacing as untracked files until they are moved or deleted.
/watch-usage-app/build/
/watch-usage-app/dist/
/watchface-grid/build/
/watchface-grid/dist/
/watchface-terminal/build/
/watchface-terminal/dist/

# Python tooling cache (font generators)
__pycache__/

# Kotlin compiler session cache (created by Gradle builds)
.kotlin/

# Garmin's watch-face icons, cached by garmin/faces/grid/editor/build_icon_picker.py --embed-garmin.
# Garmin's artwork: never commit it (the committed icon-picker.html links to Garmin's site instead).
garmin/faces/grid/editor/.garmin-icons/
